# Copie para .env em desenvolvimento. Em produção, configure no painel do Render.
PORT=3000
# Origens do site que podem chamar a API (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Supabase (banco e login). Sem isso, a API roda sem contas: o progresso fica no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (tutor). Sem isso, o tutor responde 503 "indisponível".
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Orçamento de "pensamento" do modelo. 0 desliga (respostas mais rápidas e baratas no Flash).
GEMINI_THINKING_BUDGET=0

# Protege as rotas /api/v1/ops/* de leitura.
OPS_TOKEN=

# Limites
AI_DAILY_BUDGET=500
TUTOR_PER_IP_HOUR=15
# Atrás do Cloudflare, o IP real vem em CF-Connecting-IP. Ponha "false" se a API não estiver atrás do Cloudflare.
TRUST_CF_CONNECTING_IP=true
